// impl blocks attach methods. `self` is explicit; Type::name(...) calls a
// method as a plain function (e.g. a constructor that takes no self).
struct Point { x: Int, y: Int }
impl Point {
    fn new(x, y) { return Point { x: x, y: y } }
    fn norm2(self) { return self.x * self.x + self.y * self.y }
    fn shift(self, d) {
        self.x = self.x + d
        return self
    }
}
let p = Point::new(3, 4)
print(p.norm2())
p.shift(1)
print(p.x)
print(Point::norm2(p))
