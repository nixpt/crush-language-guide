// A method call on a `for` loop variable is a method call, as on any local
// (fixed in crush-ast #256; before that it was compiled as a capability named
// `s.area` and the program was refused).
struct Sq { side: Int }
impl Sq { fn area(self) { return self.side * self.side } }
for s in [Sq { side: 2 }, Sq { side: 3 }] {
    print(s.area())
}
