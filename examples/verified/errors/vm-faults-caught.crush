// catch also sees VM faults (crush-ast CRUSH-369): an out-of-range index,
// division by zero, a failing capability. The caught value is an error value
// carrying the fault's message.
try {
    print([1][3])
} catch e {
    print("caught: " + e)
}
try {
    print(10 / 0)
} catch e {
    print(conv.type_of(e))
}
print("after")
