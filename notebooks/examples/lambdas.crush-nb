   },
   "source": "let add = |a, b| {\n    return a + b\n}\nlet mul = |x, y| x * y\nlet ident = |n| n\nprint(add(1, 2))\nprint(mul(4, 5))\nprint(6 |> ident)\n",
   "state": {
