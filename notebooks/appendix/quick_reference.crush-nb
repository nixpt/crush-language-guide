  {
   "id": "appendix-quick-reference-md-9",
   "kind": {
    "type": "markdown"
   },
   "source": "### Structs and objects ([Types](https://docs.crushlang.org/crush/types.html))\n",
   "state": {
    "status": "done"
   },
   "meta": {},
   "outputs": []
  },
  {
   "id": "appendix-quick-reference-5",
   "kind": {
    "type": "crush"
   },
   "source": "struct Point { x: Int, y: Int }\nimpl Point {\n    fn sum(self) { return self.x + self.y }\n}\nlet p = Point { x: 3, y: 4 }\nlet o = {\"name\": \"crush\"}\no[\"lang\"] = \"en\"\nprint(p.sum())\nprint(o.name + \"/\" + o[\"lang\"])\n",
   "state": {
    "status": "pending"
   },
