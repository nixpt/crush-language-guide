   "kind": {
    "type": "markdown"
   },
   "source": "### Structs and objects ([Types](https://docs.crushlang.org/crush/types.html))\n",
   "state": {
    "status": "done"
   },
   "meta": {},
   "outputs": []
  },
  {
   "id": "appendix-quick-reference-4",
   "kind": {
    "type": "crush"
   },
   "source": "struct Point { x, y }\nlet p = new Point()\np.x = 3\np.y = 4\nlet o = {\"name\": \"crush\"}\nprint(p.x + p.y)\nprint(o.name)\n",
