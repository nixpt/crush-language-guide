  },
  {
   "id": "casm-readme-1",
   "kind": {
    "type": "crush"
   },
   "source": "fn add(a, b) {\n    return a + b\n}\nlet x = add(2, 3)\nio.print(\"x = \", x)\n",
   "state": {
    "status": "pending"
   },
