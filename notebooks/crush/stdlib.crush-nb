   "id": "crush-stdlib-7",
   "kind": {
    "type": "crush"
   },
   "source": "print(path.join(\"a\", \"b.txt\"))\nprint(path.dirname(\"/x/y/z.txt\"))\nprint(path.basename(\"/x/y/z.txt\"))\nprint(path.stem(\"z.tar.gz\"))\nprint(path.normalize(\"a/./b/../c\"))\n",
   "state": {
