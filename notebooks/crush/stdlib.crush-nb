     }
    }
   },
   "outputs": []
  },
  {
   "id": "crush-stdlib-md-5",
   "kind": {
    "type": "markdown"
   },
   "source": "## Conversion — `conv.*`\n\n`conv.to_int`, `conv.to_float`, `conv.to_str`, `conv.to_bool`,\n`conv.parse_int(text, radix)`, `conv.parse_float`, `conv.type_of`, plus the\nalways-on `conv.chr` / `conv.ord`.\n",
   "state": {
    "status": "done"
   },
   "meta": {},
   "outputs": []
  },
  {
   "id": "crush-stdlib-3",
   "kind": {
    "type": "crush"
   },
   "source": "print(conv.to_int(\"42\") + 1)\nprint(conv.to_int(3.9))\nprint(conv.parse_int(\"ff\", 16))\nprint(conv.parse_int(\"101\", 2))\nprint(conv.to_float(\"2\"))\nprint(conv.type_of(3.5))\n",
   "state": {
    "status": "pending"
   },
