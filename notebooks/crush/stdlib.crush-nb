   "kind": {
    "type": "markdown"
   },
   "source": "## JSON — `json.*`\n\n`json.parse(text)` → object/array/scalar; `json.stringify(value)`;\n`json.stringify_pretty(value)`.\n",
   "state": {
    "status": "done"
   },
   "meta": {},
   "outputs": []
