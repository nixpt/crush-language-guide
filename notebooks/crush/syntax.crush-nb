  },
  {
   "id": "crush-syntax-md-3",
   "kind": {
    "type": "markdown"
   },
   "source": "Functions can be called before they are defined:\n",
   "state": {
    "status": "done"
   },
   "meta": {},
   "outputs": []
  },
  {
