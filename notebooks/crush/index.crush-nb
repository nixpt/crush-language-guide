  {
   "id": "crush-readme-2",
   "kind": {
    "type": "crush"
   },
   "source": "struct Point { x: Int, y: Int }\nimpl Point {\n    fn distance_sq(self) { return self.x * self.x + self.y * self.y }\n}\n\nlet points = [Point { x: 3, y: 4 }, Point { x: 1, y: 1 }]\nlet far = |p| p.distance_sq() > 10\nlet i = 0\nwhile i < len(points) {\n    let p = points[i]\n    if far(p) {\n        print(\"far: \" + p.distance_sq())\n    }\n    i = i + 1\n}\n",
   "state": {
