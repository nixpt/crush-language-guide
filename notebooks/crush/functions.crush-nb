     }
    }
   },
   "outputs": []
  },
  {
   "id": "crush-functions-md-11",
   "kind": {
    "type": "markdown"
   },
   "source": "Anonymous functions are written `|params| expression` or `|params| { block }`:\n",
   "state": {
    "status": "done"
   },
   "meta": {},
   "outputs": []
  },
  {
   "id": "crush-functions-6",
   "kind": {
    "type": "crush"
   },
   "source": "let double = |x| { return x * 2 }\nlet add = |a, b| a + b\nprint(double(21))\nprint(add(2, 3))\n",
   "state": {
    "status": "pending"
   },
   "meta": {
    "tags": [
     "guide",
     "runnable"
    ],
    "extra": {
     "guide": {
