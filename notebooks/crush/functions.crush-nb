      "expect_error": "call depth quota exceeded"
     }
    }
   },
   "outputs": []
  },
  {
   "id": "crush-functions-md-9",
   "kind": {
    "type": "markdown"
   },
   "source": "## Higher-order functions and lambdas\n\nA function name is a value. Store it, pass it, call it through the variable:\n",
   "state": {
    "status": "done"
   },
   "meta": {},
   "outputs": []
  },
  {
   "id": "crush-functions-5",
   "kind": {
    "type": "crush"
   },
   "source": "fn double(n) {\n    return n * 2\n}\nfn apply(f, x) {\n    return f(x)\n}\nlet f = double\nprint(f(21))\nprint(apply(double, 4))\n",
   "state": {
    "status": "pending"
   },
   "meta": {
    "tags": [
     "guide",
     "runnable"
    ],
    "extra": {
     "guide": {
