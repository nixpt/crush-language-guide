  {
   "id": "crush-capabilities-md-7",
   "kind": {
    "type": "markdown"
   },
   "source": "With it, and with the filesystem confined to a directory:\n",
   "state": {
    "status": "done"
   },
   "meta": {},
   "outputs": []
  },
