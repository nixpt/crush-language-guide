      "browser": "host",
      "why": "uses `@python` blocks (polyglot), which the in-browser runtime does not provide",
      "expect_error": "cannot marshal output variable 'obj'"
     }
    }
   },
   "outputs": []
  },
  {
   "id": "crush-polyglot-md-13",
   "kind": {
    "type": "markdown"
   },
   "source": "Blocks compose through Crush variables, across languages:\n",
   "state": {
    "status": "done"
   },
   "meta": {},
   "outputs": []
  },
  {
   "id": "crush-polyglot-7",
   "kind": {
    "type": "crush"
   },
   "source": "let x = 1\n@python {\ny = x + 1\n}\n@javascript {\nconst z = y * 10\n}\n@python {\nw = z + 1\n}\nprint(w)\n",
   "state": {
    "status": "pending"
   },
   "meta": {
    "tags": [
     "guide",
     "needs-host"
    ],
