   "kind": {
    "type": "markdown"
   },
   "source": "An output variable that can't be serialised to JSON (a class instance, an open\nfile, a function) fails the block with a clear error rather than being dropped:\n",
   "state": {
    "status": "done"
   },
   "meta": {},
   "outputs": []
  },
