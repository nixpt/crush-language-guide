   },
   "source": "let n = 5\nlet tags = [\"a\", \"b\"]\n@javascript -> out {\nconst out = [n * 2, tags.length, tags.join(\"+\")]\n}\nprint(out)\n",
   "state": {
    "status": "pending"
   },
   "meta": {
