      "browser": "run",
      "expect_output": "3\n"
     }
    }
   },
   "outputs": []
  },
  {
   "id": "crush-control-flow-md-7",
   "kind": {
    "type": "markdown"
   },
   "source": "## For\n\n### Over an array\n",
   "state": {
    "status": "done"
   },
   "meta": {},
   "outputs": []
  },
  {
   "id": "crush-control-flow-4",
   "kind": {
    "type": "crush"
   },
   "source": "for n in [10, 20, 30] {\n    print(n)\n}\n",
   "state": {
    "status": "pending"
   },
   "meta": {
    "tags": [
     "guide",
     "runnable"
    ],
    "extra": {
     "guide": {
      "src": "crush/control_flow.md:67",
      "browser": "run",
      "expect_output": "10\n20\n30\n"
     }
    }
   },
   "outputs": []
  },
  {
   "id": "crush-control-flow-md-9",
   "kind": {
    "type": "markdown"
   },
   "source": "### Over a range\n\n`a..b` is half-open (excludes `b`). There is no inclusive `..=` and no `range()`\nfunction:\n",
   "state": {
    "status": "done"
   },
   "meta": {},
   "outputs": []
  },
  {
   "id": "crush-control-flow-5",
   "kind": {
    "type": "crush"
   },
   "source": "for i in 0..3 {\n    print(i)\n}\n\nlet items = [\"x\", \"y\"]\nfor i in 0..len(items) {\n    print(items[i])\n}\n",
   "state": {
    "status": "pending"
   },
   "meta": {
    "tags": [
     "guide",
     "runnable"
    ],
    "extra": {
     "guide": {
      "src": "crush/control_flow.md:85",
      "browser": "run",
      "expect_output": "0\n1\n2\nx\ny\n"
     }
    }
   },
   "outputs": []
  },
  {
   "id": "crush-control-flow-6",
   "kind": {
    "type": "crush"
   },
   "source": "fn main() {\n    for i in 1..=3 {\n        print(i)\n    }\n}\n",
   "state": {
    "status": "pending"
   },
   "meta": {
    "tags": [
     "guide",
     "expected-failure"
    ],
    "extra": {
     "guide": {
